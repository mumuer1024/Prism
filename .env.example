# Intel Briefing - 环境变量配置示例
# 复制此文件为 .env 并填入你的实际值

# ═══════════════════════════════════════════════════════════
# 通用推理模型端点（营收分析 / 通用任务）
# 支持任意 OpenAI 兼容端点（NewAPI / OpenRouter / 官方等）
# ═══════════════════════════════════════════════════════════
LLM_API_FORMAT=openai
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════
# X/Twitter 搜索端点（仅用于 Grok，必须 xAI 官方）
# 因为只有 Grok 能访问 X 实时数据，必须使用 xAI 官方 API
# ═══════════════════════════════════════════════════════════
XAI_API_FORMAT=openai
XAI_BASE_URL=https://api.x.ai/v1/chat/completions
XAI_API_KEY=xai-your-xai-api-key-here
XAI_MODEL=grok-beta

# ═══════════════════════════════════════════════════════════
# 翻译模型端点（ArXiv 摘要翻译 / 博客摘要）
# 支持 OpenAI 兼容 / Gemini 原生 / Claude 原生 三种格式
# ═══════════════════════════════════════════════════════════
TRANSLATOR_API_FORMAT=gemini
TRANSLATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
TRANSLATOR_API_KEY=your-gemini-api-key-here
TRANSLATOR_MODEL=gemini-2.5-flash-lite

# 向后兼容：TRANSLATOR_API_KEY 也接受 GEMINI_API_KEY 作为 fallback
# GEMINI_API_KEY=your-gemini-api-key-here

# ═══════════════════════════════════════════════════════════
# 数据源 API Keys
# ═══════════════════════════════════════════════════════════

# GitHub Personal Access Token（必需，用于 GitHub Trending）
# 创建地址：https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# Product Hunt Token（可选，用于 Product Hunt 数据）
# 创建地址：https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your-producthunt-token-here

# Tavily Token（可选，用于 Tavily AI 搜索）
# 创建地址：https://tavily.com/
TAVILY_TOKEN=tvly-your-tavily-token-here

# DailyHotApi 实例地址（热榜数据源）
# 用于获取知乎、微博、B站等平台热榜数据
DAILYHOT_API_URL=https://dailyhot.prismins.site

# ═══════════════════════════════════════════════════════════
# 数据源开关配置（可选，默认全部启用）
# 设置为 false 可禁用对应数据源
# ═══════════════════════════════════════════════════════════
SOURCE_ENABLED_HACKERNEWS=true
SOURCE_ENABLED_GITHUB_TRENDING=true
SOURCE_ENABLED_ARXIV=true
SOURCE_ENABLED_PRODUCTHUNT=true
SOURCE_ENABLED_V2EX=true
SOURCE_ENABLED_36KR=true
SOURCE_ENABLED_WALLSTREET=true
SOURCE_ENABLED_X_GROK=true
SOURCE_ENABLED_HN_BLOGS=true
SOURCE_ENABLED_CHROME=true
SOURCE_ENABLED_XHS=true
SOURCE_ENABLED_TAVILY=true

# ═══════════════════════════════════════════════════════════
# 代理配置（可选，用于中国大陆网络环境）
# ═══════════════════════════════════════════════════════════
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ═══════════════════════════════════════════════════════════
# 服务配置（Docker 部署可选）
# ═══════════════════════════════════════════════════════════
# PORT=8680
# TZ=Asia/Shanghai

# ═══════════════════════════════════════════════════════════
# V2.0 用户系统配置
# ═══════════════════════════════════════════════════════════

# --- 基础配置 ---
DEBUG=false
APP_NAME=Prism
APP_VERSION=2.0.0

# --- JWT 配置 ---
# 生产环境务必修改为随机字符串！
JWT_SECRET_KEY=prism-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 验证码配置 ---
VERIFY_CODE_LENGTH=6
VERIFY_CODE_EXPIRE_MINUTES=5
VERIFY_CODE_RESEND_SECONDS=60

# --- 邮件配置（自建 SMTP）---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@example.com

# --- 腾讯云邮件配置（可选，优先级高于 SMTP）---
# TENCENT_SECRET_ID=your-tencent-secret-id
# TENCENT_SECRET_KEY=your-tencent-secret-key

# --- GitHub OAuth ---
# 创建地址：https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- 微信 OAuth（可选）---
# 创建地址：https://open.weixin.qq.com/
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret
# WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback

# --- 免费用户配置 ---
FREE_DAILY_LIMIT=3
FREE_SOURCES=hacker_news,product_hunt,github_trending,36kr
FREE_TOOLS=bounty_hunter,alpha_radar,revenue_architect,narrator

# --- 邀请返利配置 ---
INVITE_BONUS_COUNT=3
INVITEE_BONUS_COUNT=3

# --- 兑换码配置 ---
REDEMPTION_CODE_PREFIX=PRISM-
REDEMPTION_CODE_LENGTH=8

# --- 邀请码配置 ---
INVITE_CODE_PREFIX=PRISM-
INVITE_CODE_LENGTH=8

# --- 数据库配置 ---
DATABASE_URL=sqlite:///./data/prism.db

# --- 功能开关 ---
FEATURE_USER_SYSTEM=true
FEATURE_OAUTH_GITHUB=true
FEATURE_OAUTH_WECHAT=false
FEATURE_INVITE_SYSTEM=true
FEATURE_FREE_TIER=true
FEATURE_REDEMPTION_CODE=true
